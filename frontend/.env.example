# Copiar a .env.local y completar (nunca commitear .env.local)
# cp .env.example .env.local

# --- API / proxy ---
# URL pública del API (proxy Next o Django directo)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Base Django para el proxy server-side (Next rewrites)
DJANGO_API_BASE=http://127.0.0.1:8000

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pagos (Wompi) ---
# NEXT_PUBLIC_WOMPI_PUBLIC_KEY=

# --- Sentry (opcional) ---
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ENV=development
# NEXT_PUBLIC_DJANGO_ENV=development
# Token para subir source maps en build (CI/prod)
# SENTRY_AUTH_TOKEN=

# --- Redes / contacto (opcional) ---
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_TIKTOK_URL=
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_LINKEDIN_URL=
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_WHATSAPP_PHONE=

# --- Media (prod; opcional en dev) ---
# NEXT_PUBLIC_MEDIA_BASE_URL=
# NEXT_PUBLIC_BACKEND_URL=

# --- Analytics (solo se cargan en producción) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# --- SSR / Docker (avanzado) ---
# INTERNAL_API_ORIGIN=
# NEXT_SSR_DIRECT_DJANGO=0
