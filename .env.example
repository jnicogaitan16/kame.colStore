# Copiar a .env y completar (nunca commitear .env)
# cp .env.example .env

# --- Django core ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Coma-separado; incluir host LAN si probás desde el celular
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Opcional: IP LAN para ALLOWED_HOSTS (ej. 192.168.1.10)
# DJANGO_LAN_IP=
# Orígenes extra para CSRF (coma-separado), ej. túnel ngrok o IP LAN
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.20.128:3000,https://xxxx.ngrok-free.dev
# DJANGO_SECURE_SSL_REDIRECT=False

# --- Base de datos ---
# PostgreSQL (Docker/prod). Sin DATABASE_URL usa SQLite local (db.sqlite3).
# DATABASE_URL=postgres://kamecol:kamecol_pass@localhost:5432/kamecol
# DB_SSL_REQUIRE=false
# DB_CONN_MAX_AGE=600

# --- Entorno / URLs ---
DJANGO_ENV=development
FRONTEND_SITE_URL=http://localhost:3000
# DEV_STOREFRONT_URL=

# --- Cloudflare R2 (media en prod; vacío en dev local) ---
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
# R2_ENDPOINT_URL=
# R2_PUBLIC_BASE_URL=

# --- Wompi (pagos) ---
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_EVENTS_SECRET=
# WOMPI_INTEGRITY_SECRET=

# --- Email (Resend en prod; console backend en dev) ---
# RESEND_API_KEY=
# RESEND_API_BASE_URL=https://api.resend.com
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=
# TRANSACTIONAL_FROM_EMAIL=

# --- Sentry (opcional) ---
# SENTRY_DSN=
# SENTRY_DEBUG=

# --- Admin / seguridad ---
# ADMIN_ALLOWED_IPS=

# --- Cache de imágenes (opcional) ---
# ENABLE_PRODUCTIMAGE_EAGER_CACHE=
